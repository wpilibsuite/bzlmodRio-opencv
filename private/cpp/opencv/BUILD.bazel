load("@rules_cc//cc:defs.bzl", "cc_library")
load("//private/cpp/opencv:wrapped_cc_import.bzl", "opencv_libraries")

alias(
    name = "header_files",
    actual = "@org_wpilib_opencv-cpp_headers//:header_files",
    visibility = ["@bzlmodrio-opencv//:__subpackages__"],
)

[
    [alias(
        name = lib + extension,
        actual = select({
            "@wpilib_toolchains//conditions:linux_x86_64": "@org_wpilib_opencv-cpp_linuxx86-64//:" + lib + extension,
            "@wpilib_toolchains//conditions:linux_x86_64_debug": "@org_wpilib_opencv-cpp_linuxx86-64debug//:" + lib + extension,
            "@wpilib_toolchains//conditions:osx": "@org_wpilib_opencv-cpp_osxuniversal//:" + lib + extension,
            "@wpilib_toolchains//conditions:osx_debug": "@org_wpilib_opencv-cpp_osxuniversaldebug//:" + lib + extension,
            "@wpilib_toolchains//conditions:windows_arm64": "@org_wpilib_opencv-cpp_windowsarm64//:" + lib + extension,
            "@wpilib_toolchains//conditions:windows_arm64_debug": "@org_wpilib_opencv-cpp_windowsarm64debug//:" + lib + extension,
            "@wpilib_toolchains//conditions:windows_x86_64": "@org_wpilib_opencv-cpp_windowsx86-64//:" + lib + extension,
            "@wpilib_toolchains//conditions:windows_x86_64_debug": "@org_wpilib_opencv-cpp_windowsx86-64debug//:" + lib + extension,
            "@wpilib_toolchains//constraints/is_systemcore:systemcore": "@org_wpilib_opencv-cpp_linuxsystemcore//:" + lib + extension,
            "@wpilib_toolchains//constraints/is_systemcore:systemcore_debug": "@org_wpilib_opencv-cpp_linuxsystemcoredebug//:" + lib + extension,
            "@wpilib_toolchains//constraints/is_trixie64:trixie64": "@org_wpilib_opencv-cpp_linuxarm64//:" + lib + extension,
            "@wpilib_toolchains//constraints/is_trixie64:trixie64_debug": "@org_wpilib_opencv-cpp_linuxarm64debug//:" + lib + extension,
        }),
        visibility = ["//visibility:public"],
    ) for lib in opencv_libraries]
    for extension in [
        "_shared",
        "_shared_import",
    ]
]

alias(
    name = "opencv",
    actual = select({
        "@wpilib_toolchains//conditions:linux_x86_64": "@org_wpilib_opencv-cpp_linuxx86-64//:static",
        "@wpilib_toolchains//conditions:linux_x86_64_debug": "@org_wpilib_opencv-cpp_linuxx86-64debug//:static",
        "@wpilib_toolchains//conditions:osx": "@org_wpilib_opencv-cpp_osxuniversal//:static",
        "@wpilib_toolchains//conditions:osx_debug": "@org_wpilib_opencv-cpp_osxuniversaldebug//:static",
        "@wpilib_toolchains//conditions:windows_arm64": "@org_wpilib_opencv-cpp_windowsarm64//:static",
        "@wpilib_toolchains//conditions:windows_arm64_debug": "@org_wpilib_opencv-cpp_windowsarm64debug//:static",
        "@wpilib_toolchains//conditions:windows_x86_64": "@org_wpilib_opencv-cpp_windowsx86-64//:static",
        "@wpilib_toolchains//conditions:windows_x86_64_debug": "@org_wpilib_opencv-cpp_windowsx86-64debug//:static",
        "@wpilib_toolchains//constraints/is_systemcore:systemcore": "@org_wpilib_opencv-cpp_linuxsystemcore//:static",
        "@wpilib_toolchains//constraints/is_systemcore:systemcore_debug": "@org_wpilib_opencv-cpp_linuxsystemcoredebug//:static",
        "@wpilib_toolchains//constraints/is_trixie64:trixie64": "@org_wpilib_opencv-cpp_linuxarm64//:static",
        "@wpilib_toolchains//constraints/is_trixie64:trixie64_debug": "@org_wpilib_opencv-cpp_linuxarm64debug//:static",
    }),
    visibility = ["@bzlmodrio-opencv//:__subpackages__"],
)

cc_library(
    name = "jni",
    srcs = select({
        "@wpilib_toolchains//conditions:linux_x86_64": ["@org_wpilib_opencv-cpp_linuxx86-64//:jni"],
        "@wpilib_toolchains//conditions:linux_x86_64_debug": ["@org_wpilib_opencv-cpp_linuxx86-64debug//:jni"],
        "@wpilib_toolchains//conditions:osx": ["@org_wpilib_opencv-cpp_osxuniversal//:jni"],
        "@wpilib_toolchains//conditions:osx_debug": ["@org_wpilib_opencv-cpp_osxuniversaldebug//:jni"],
        "@wpilib_toolchains//conditions:windows_arm64": ["@org_wpilib_opencv-cpp_windowsarm64//:jni"],
        "@wpilib_toolchains//conditions:windows_arm64_debug": ["@org_wpilib_opencv-cpp_windowsarm64debug//:jni"],
        "@wpilib_toolchains//conditions:windows_x86_64": ["@org_wpilib_opencv-cpp_windowsx86-64//:jni"],
        "@wpilib_toolchains//conditions:windows_x86_64_debug": ["@org_wpilib_opencv-cpp_windowsx86-64debug//:jni"],
        "@wpilib_toolchains//constraints/is_systemcore:systemcore": ["@org_wpilib_opencv-cpp_linuxsystemcore//:jni"],
        "@wpilib_toolchains//constraints/is_systemcore:systemcore_debug": ["@org_wpilib_opencv-cpp_linuxsystemcoredebug//:jni"],
        "@wpilib_toolchains//constraints/is_trixie64:trixie64": ["@org_wpilib_opencv-cpp_linuxarm64//:jni"],
        "@wpilib_toolchains//constraints/is_trixie64:trixie64_debug": ["@org_wpilib_opencv-cpp_linuxarm64debug//:jni"],
    }),
    linkstatic = 1,
    visibility = ["@bzlmodrio-opencv//:__subpackages__"],
    deps = [lib + "_shared_import" for lib in opencv_libraries] + [
        "@org_wpilib_opencv-cpp_headers//:headers",
    ],
)
